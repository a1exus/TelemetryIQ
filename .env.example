# PlayStation IP address.
# Set this if auto-discovery fails (e.g. PS and PC on different subnets).
# Leave unset to use automatic discovery.
PS_IP=

# Heartbeat type controls which telemetry data GT7 sends.
# Only one type can be active per session.
#
#   A  — Standard (296 bytes): speed, RPM, gear, boost, throttle, brake,
#         G-forces, lap times, position. Default GT7 format.
#
#   B  — Motion data (316 bytes): everything in A, plus steering input,
#         lateral/longitudinal/vertical motion (sway, heave, surge),
#         and slip angle. Best for full telemetry dashboards.
#
#   ~  — Extended data: filtered throttle/brake inputs, energy recovery
#         (hybrid/EV cars), and reserved fields for future GT7 expansion.
#
# Default: B (most complete for live dashboards).
GT7_HEARTBEAT_TYPE=B

# SQLite database path (inside container).
# Default: /data/telemetry.db — persisted in Docker volume telemetry_data.
DB_PATH=/data/telemetry.db
